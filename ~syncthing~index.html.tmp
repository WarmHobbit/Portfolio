<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="stylesheet" href="style.css" />
		<!-- Readymade css backgrounds from pattern.css -->
		<!-- <link href="https://unpkg.com/pattern.css" rel="stdots-lgylesheet" /> -->
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
		/>
		<link
			rel="stylesheet"
			href="./bootstrap-5.3.8-dist/css/bootstrap.min.css"
		/>
		<link rel="stylesheet" href="pattern.min.css" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IM+Fell+DW+Pica:ital@0;1&display=swap"
			rel="stylesheet"
		/>
		<title>Portfolio</title>
	</head>
	<body>
		<div
			class="container-fluid pattern-cross-dots-sm bg-dark text-white min-vh-100 min-vw-100"
		>
			<div class="row">
				<div class="col-md-1 icons min-vh-100 glass">
					<h1><i class="bi bi-person-circle"></i></h1>
					<h1><i class="bi bi-window-stack"></i></h1>
					<h1><i class="bi bi-github"></i></h1>
					<h1><i class="bi bi-envelope"></i></h1>
				</div>
				<div class="col-md-11 container glass">
					<!-- INTRO -->
					<div class="slide container">
						<div class="col-md-3 center mx-4">
							<img
								src="me.webp"
								alt=""
								height="75%"
								width="75%"
								style="
									border-radius: 10%;
									border-style: dashed;
									border-width: 2px;
									border-color: antiquewhite;
								"
							/>
						</div>
						<div class="col-md-auto center">
							<h3>
								Learner <br />
								Builder <br />
								<span style="color: firebrick"> Engineer <br /></span>

								<br />
								<span class="italic">I'm Atin Kapruwan</span>
							</h3>
						</div>
						<div class="center scroll-icon">
							<h2><i class="bi bi-arrow-down-circle"></i></h2>
						</div>
					</div>
					<!-- ABOUT -->
					<div class="slide container">
						<div class="center">
							<h1>About me</h1>
							<p>
								Lorem, ipsum dolor sit amet consectetur adipisicing elit.
								Accusamus similique exercitationem non corrupti magni inventore
								quas itaque reiciendis architecto molestias? Ea aliquid quo in
								earum beatae. Magnam inventore dolore non!
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<script src="script.js"></script>
		<script src="./bootstrap-5.3.8-dist/js/bootstrap.bundle.min.js"></script>
	</body>
</html>
