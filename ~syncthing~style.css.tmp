.glass {
	background: rgba(0, 8, 66, 0.215); /* semi-transparent black */
	backdrop-filter: blur(1px); /* the blur magic */
	border-radius: 12px;
	border: 1px solid rgba(255, 255, 255, 0.1); /* subtle edge */
	padding: 1.5rem;
}

.hero {
	min-height: 100vh;
	display: flex;
	align-items: center;
	justify-content: center;
}

.icons {
	position: sticky;
	display: flex;
	flex-direction: column;
	justify-content: space-around;
	align-items: center;
	border-radius: 15px;
}

.content {
	width: 70%;
	transform: translateX(8%);
}

.container {
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 15px;
	font-family: "IM Fell DW Pica", serif;
	font-weight: 400;
	font-style: normal;
	/* overflow-y: scroll;
	scroll-snap-type: mandatory; */
}

.italic {
	font-family: "IM Fell DW Pica", serif;
	font-weight: 400;
	font-style: italic;
}

.center {
	display: flex;
	align-items: center;
	justify-content: center;
}

.scroll-icon {
	position: absolute;
	bottom: 0;
}

.slide {
	/* height: 100vh; */
	/* scroll-snap-align: start; */
}
